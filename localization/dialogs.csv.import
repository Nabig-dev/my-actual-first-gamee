[remap]

importer="csv_translation"
type="Translation"

[deps]

files=[ "res://localization/dialogs.en.translation", "res://localization/dialogs.es.translation", "res://localization/dialogs.pt_BR.translation" ]

source_file="res://localization/dialogs.csv"
dest_files=[ "res://localization/dialogs.en.translation", "res://localization/dialogs.es.translation", "res://localization/dialogs.pt_BR.translation" ]

[params]

compress=true
delimiter=0
