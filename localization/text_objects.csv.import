[remap]

importer="csv_translation"
type="Translation"

[deps]

files=[ "res://localization/text_objects.en.translation", "res://localization/text_objects.es.translation", "res://localization/text_objects.pt_BR.translation" ]

source_file="res://localization/text_objects.csv"
