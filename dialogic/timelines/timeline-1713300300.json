		{
			"character": "character-1710264530.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Ohh, has logrado llegar hasta aquí."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "Angry",
			"text": "shay Avicena, Adeptis del Nitrogeno..."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Era de esperarse que una rata rastrera haya hecho todo esto con tal de esconderse."
		},
		{
			"character": "character-1710264530.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "La realidad es que soy el tesorero de los Ahuizotes. Mi fuerte no es la pelea."
		},
		{
			"character": "character-1710264530.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Toda nuestra organización no puede sostenerse con la fe de nuestros seguidores."
		},
		{
			"character": "character-1710264530.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Mi función es recolectar el diezmo, necesario para que podamos continuar con nuestra sagrada misión."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Tonterías, solo eres un traficante que encontró un negocio con la fe de inocentes."
		},
		{
			"character": "character-1710264530.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "..."
		},
		{
			"character": "character-1710264530.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "No es mi culpa que ellos sean unos imbéciles."
		},
		{
			"character": "character-1710264530.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Suficiente de charla. ¡Con este frío te cortaré la carne y congelaré tus huesos!"
		}
	],
