			"type": 2,
			"z_index": 0
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "¿¡Qué ha dicho!?"
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Oh, ¿es acaso usted una Adeptis? No pensé que los Ahuizotes vendrían tan rápido en nuestro rescate."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Señora, no soy ningún Adeptis. Mi nombre es nabig, Alquimista Oficial de La Orden."
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "¿La Orden? ¿Qué hace aquí? Hace décadas declaramos que solo seguimos las enseñanzas de Athos."
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "La niebla es un castigo divino que caerá también sobre las demás ciudades, hay que cubrirse bajo la piedad de nuestro señor Athos."
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Los Ahuizotes comandados por el señor Trithemius han prometido velar por nuestro bienestar."
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Pronto ellos nos liberarán de la niebla..."
		},
		{
			"animation": "[Default]",
			"animation_length": 0,
			"change_mirror_portrait": false,
			"change_z_index": false,
			"character": "character-1710263881.json",
			"event_id": "dialogic_002",
			"mirror_portrait": false,
			"portrait": "Default",
			"portrait_definition": "",
			"position": {
				"0": false,
