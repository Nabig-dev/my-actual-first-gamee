			"portrait": "",
			"text": "Oh, señorita nabig, usted es un ángel."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "Meh",
			"text": "Gracias..."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "Default",
			"text": "Veo que su nieto se encuentra mejor."
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "Default",
			"text": "Así es. Hemos seguido las indicaciones de los alquimistas de La Orden."
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "Default",
			"text": "Tomamos precauciones, y bebemos los medicamentos de nos ofrecen."
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "Default",
			"text": "No podemos decir que hemos superado esta crisis en su totalidad."
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "Default",
			"text": "Pero agradezco que usted y La Orden trabajen arduamente para ayudarnos."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "..."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Bien, me voy..."
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Ah, permítame obsequiarle algo."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "No es necesario..."
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "No es mucho, pero creo que usted podrá darle un buen uso."
		},
