		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Bien, deberé hablar con la señora Alessa acerca de esto. También debo investigar más este lugar..."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Aunque si este lugar es afectado por algún gas que provoca alucinaciones... Debo darme prisa."
		}
