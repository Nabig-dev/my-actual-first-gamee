		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Disculpe... ¿qué lugar es este?"
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Oh, una forastera... Usted se encuentra en la ciudad de Birstall."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Qué extraño, este lugar se mira muy diferente de lo que he escuchado."
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Birstall era la segunda ciudad más importante del país, hasta que [color=yellow]la niebla llegó.[/color]"
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Mi nombre es Evelyn. Construí esta pequeña morada improvisada para resguardarme de la niebla..."
		},
		{
			"character": "character-1710263881.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "... Con fe en que la gracia de Athos nos salve."
		},
		{
			"event_id": "shake_dialog_node"
		},
		{
			"animation": "[Default]",
			"animation_length": 0,
			"change_mirror_portrait": false,
			"change_position": false,
			"change_z_index": false,
			"character": "character-1649630816.json",
