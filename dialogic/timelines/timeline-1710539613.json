				"4": false
			},
			"type": 1,
			"z_index": 0
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "Default",
			"text": "Ahora entiendo las cosas... Ese maldito de john ha estado metiendo basura en las mentes de estas personas durante años..."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "No tiene caso discutir sobre creencias."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Debo adentrarme en esta ciudad, podría encontrar más pistas sobre john."
