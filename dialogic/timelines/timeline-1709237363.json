		},
		{
			"character": "character-1702344268.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Xandria, qué gusto verte."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "No esperaba que construyeran una estación de tren aquí..."
		},
		{
			"character": "character-1702344268.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Se ha invertido bastante dinero para la construcción del puente que permite el paso del tren hasta estas isletas."
		},
		{
			"character": "character-1702344268.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Todavía no se ha abierto al público debido a que los lugareños no parecen estar conformes."
