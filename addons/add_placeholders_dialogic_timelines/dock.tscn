[connection signal="pressed" from="HBoxContainer/BtnOpen" to="." method="_on_BtnOpen_pressed"]
[connection signal="pressed" from="HBoxContainer/BtnHelp" to="." method="_on_BtnHelp_pressed"]
[connection signal="files_selected" from="FileDialog" to="." method="_on_FileDialog_files_selected"]
