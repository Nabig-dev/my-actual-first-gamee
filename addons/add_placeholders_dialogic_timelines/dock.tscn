[gd_scene load_steps=2 format=2]

[ext_resource path="res://addons/add_placeholders_dialogic_timelines/dock.gd" type="Script" id=1]

[node name="Dock" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource( 1 )

[node name="HBoxContainer" type="HBoxContainer" parent="."]
anchor_right = 1.0
margin_top = 5.0
margin_bottom = 25.0
custom_constants/separation = 17
alignment = 1

[node name="BtnOpen" type="Button" parent="HBoxContainer"]
margin_left = 25.0
margin_right = 198.0
margin_bottom = 20.0
text = "Open Files and convert it"

[node name="BtnHelp" type="Button" parent="HBoxContainer"]
margin_left = 215.0
margin_right = 295.0
margin_bottom = 20.0
text = "Como usar"

[node name="MarginContainer" type="MarginContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
margin_top = 28.0
custom_constants/margin_right = 10
custom_constants/margin_top = 10
custom_constants/margin_left = 10
custom_constants/margin_bottom = 10

[node name="TextEdit" type="TextEdit" parent="MarginContainer"]
margin_left = 10.0
margin_top = 10.0
margin_right = 310.0
margin_bottom = 142.0
show_line_numbers = true
caret_blink = true

[node name="FileDialog" type="FileDialog" parent="."]
