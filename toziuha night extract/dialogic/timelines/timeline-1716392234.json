		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "(Don't change)",
			"text": "No puedo hacerlo... Por favor... reacciona. ¿Acaso ya no me reconoces?"
		},
		{
			"character": "character-1677087468.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "..."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "No podía creerlo, pero ahora estoy segura, tú eres Isaac."
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "¿Recuerdas que me prometiste que serías el Alquimista de Hierro con tal de que me dejaran ir?"
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Lo has logrado Isaac, pero por qué... ¿¡Por qué peleas contra mí?"
		},
		{
			"character": "character-1649630816.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "¡Deja de seguir las órdenes de Johannes! Estoy aquí, podemos pelear juntos contra él."
		},
		{
			"action": 1,
			"audio_name": "all",
			"event_id": "audio_event_custom",
			"type": 1
		},
		{
			"character": "character-1677081398.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Ja, ja, ja... qué conmovedora reunión."
		},
