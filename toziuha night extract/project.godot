[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/ios/touch_delay=0.01

[layer_names]

2d_physics/layer_1="solid"
2d_physics/layer_2="solid_char"
2d_physics/layer_3="solid_oneway"
2d_physics/layer_4="solid_item"
2d_physics/layer_5="hitb_player"
2d_physics/layer_6="hitb_enemy"
2d_physics/layer_7="hurtb_player"
2d_physics/layer_8="hurtb_enemy"
2d_physics/layer_9="trigger_item"
2d_physics/layer_10="solid_enemy"
2d_physics/layer_11="water_area"
2d_physics/layer_12="unspecified"
2d_physics/layer_13="water_area_limit"
2d_physics/layer_32="pendulum_bodies"

[locale]

translations=PoolStringArray(  )
locale_filter=[ 1, [ "en_US", "es" ] ]

[physics]

common/enable_pause_aware_picking=true

[rendering]

2d/snapping/use_gpu_pixel_snap=true
vram_compression/import_etc=true
batching/precision/uv_contract=true
