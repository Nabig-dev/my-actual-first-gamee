[addons]

quick_scenes/selected_scene=0
quick_scenes/quick_run_shortcut=Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":true,"scancode":16777252,"physical_scancode":0,"unicode":0,"echo":false,"script":null)

quick_scenes/scene_list=PoolStringArray( "res://src/screens/splashscreen.tscn" )
instance_dock/scenes=[ {
"name": "Enemies",
"scenes": [ {
"scene": "res://src/game_objects/enemies/ahuizote_with_knife.tscn"
}, {
"scene": "res://src/game_objects/enemies/ahuizote_molotov.tscn"
} ],
"scroll": 0
}, {
"name": "Tilemaps",
"scenes": [ {
"scene": "res://src/game_objects/tilemaps/dungeon_forgotten_tilemap.tscn"
}, {
"scene": "res://src/game_objects/tilemaps/solid/tilemap_building.tscn"
}, {
"scene": "res://src/game_objects/tilemaps/solid/tilemap_terrain_1.tscn"
} ],
"scroll": 0
}, {
"name": "Get Objects",
"scenes": [ {
"scene": "res://src/game_objects/elemental_circuit.tscn"
} ],
"scroll": 0
} ]

[application]

config/name="Toziuha Night: Order of the Alchemists"
run/main_scene="res://initial_scene.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="ToziuhaNight_OrderOfTheAlchemists"
boot_splash/image="res://assets/sprites/misc/the_order_icon.png"
boot_splash/use_filter=false
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://assets/icons/icon.png"
config/quit_on_go_back=false
config/name.demo="Toziuha Night: Order of the Alchemists (Demo)"
config/custom_user_dir_name.demo="ToziuhaNight_OrderOfTheAlchemists_Demo"
config/custom_user_dir_name.debug="ToziuhaNight_OrderOfTheAlchemists_Debug"

[audio]

default_bus_layout="res://assets/tres/audio_bus_layout.tres"

[autoload]

Features="*res://src/autoload/features.gd"
Config="*res://src/scripts/config.gd"
CSVDBLoader="*res://src/autoload/csvdb_loader.gd"
VarsGlobal="*res://src/scripts/vars_global.gd"
Gamepad="*res://src/scripts/gamepad.gd"
Audio="*res://src/autoload/audio.tscn"
ScreenFilter="*res://src/autoload/screen_filter.tscn"
SceneChanger="*res://src/autoload/scene_changer.tscn"
Notification="*res://src/autoload/notification.tscn"
LocalizationManager.no-plugins-dev="*res://src/scripts/no-plugins-dev.gd"
ElementalCircuits="*res://src/autoload/elemental_circuits.gd"
Alloys="*res://src/autoload/alloys.gd"
Savedata="*res://src/scripts/savedata.gd"
Stopwatch="*res://src/scripts/stopwatch.gd"
ThermalBar="*res://src/autoload/thermal_bar.tscn"
InputBuffer="*res://src/autoload/input_buffer.gd"
DebugMenu="*res://src/autoload/debug_menu.tscn"
InitialDataDebug="*res://src/autoload/initial_data_debug.gd"
BugReport="*res://src/autoload/bugreport.tscn"
Achievments="*res://src/autoload/achievments.gd"
Steam="*res://addons/steam_api/steam.gd"
GooglePlayGamesServices="*res://addons/google_play_game_services_manager/singleton.gd"

[debug]

settings/fps/force_fps=60
shapes/collision/shape_color=Color( 1, 1, 1, 0.419608 )
shapes/navigation/geometry_color=Color( 0.101961, 1, 0.701961, 0.4 )

[display]

window/size/width=341
window/size/height=192
window/handheld/orientation="sensor_landscape"
window/stretch/mode="2d"
window/stretch/aspect="keep_height"
window/size/always_on_top.debug=false
window/size/resizable.release=false

[editor]

scene_naming=2

[editor_plugins]

enabled=PoolStringArray( "res://addons/AsepriteWizard/plugin.cfg", "res://addons/AutoExportVersion/plugin.cfg", "res://addons/GDScriptMacros/plugin.cfg", "res://addons/QuickSceneRunner/plugin.cfg", "res://addons/RandomAudioNodePlayer/plugin.cfg", "res://addons/Todo_Manager/plugin.cfg", "res://addons/carrousel_menu/plugin.cfg", "res://addons/dialogic/plugin.cfg", "res://addons/file_shorcuts_g3/plugin.cfg", "res://addons/gamelevels_blueprint/plugin.cfg", "res://addons/gkanban/plugin.cfg", "res://addons/godot-next/plugin.cfg", "res://addons/google_play_game_services_manager/plugin.cfg", "res://addons/interactive-music-g3/plugin.cfg", "res://addons/localization_editor_plugin_g3/plugin.cfg", "res://addons/midi/plugin.cfg", "res://addons/multidir_joystick/plugin.cfg", "res://addons/nklbdev.parallax/plugin.cfg", "res://addons/orphan_import_file_cleaner/plugin.cfg", "res://addons/steam_api/plugin.cfg", "res://addons/texture_fonts/plugin.cfg", "res://addons/uuid_generator/plugin.cfg" )

[global]

mouse=false

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d": false,
"flags/anisotropic": false,
"flags/filter": false,
"flags/mipmaps": false,
"flags/repeat": 0,
"flags/srgb": 2,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/invert_color": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}

