[remap]

importer="csv_translation"
type="Translation"

[deps]

files=[ "res://localization/inventory.es.translation", "res://localization/inventory.en.translation", "res://localization/inventory.pt_BR.translation" ]

source_file="res://localization/inventory.csv"
dest_files=[ "res://localization/inventory.es.translation", "res://localization/inventory.en.translation", "res://localization/inventory.pt_BR.translation" ]

[params]

compress=true
delimiter=0
