code = "// NOTE: Shader automatically converted from Godot Engine 3.5.1.stable's CanvasItemMaterial.

shader_type canvas_item;
render_mode blend_add;

void fragment(){
    vec2 newuv = UV;
    newuv.x += TIME/2.0;
    newuv.y -= TIME*2.0;
    vec4 c = texture(TEXTURE, newuv);
    COLOR = c;
}
"

